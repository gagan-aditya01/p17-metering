              "raw": "{\n  \"eventName\": \"llm_tokens\",\n  \"units\": 15000,\n  \"metadata\": {\n    \"model\": \"gpt-4o\",\n    \"prompt_tokens\": 5000,\n    \"completion_tokens\": 10000\n  }\n}"
