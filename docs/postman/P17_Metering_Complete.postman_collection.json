                  "var jsonData = pm.response.json();",
                  "if (jsonData.data) {",
                  "    if (jsonData.data._id) pm.collectionVariables.set('customerId', jsonData.data._id);",
                  "    if (jsonData.data.apiKey) pm.collectionVariables.set('apiKey', jsonData.data.apiKey);",
                  "}"
                ],
                "type": "text/javascript"
